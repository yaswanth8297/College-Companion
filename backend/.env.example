# College Companion Backend Environment Configuration
SECRET_KEY=dlbcoe-production-secret-key-change-in-prod
JWT_SECRET_KEY=dlbcoe-jwt-secret-key-change-in-prod
DATABASE_URL=sqlite:///../database/college.db

# Optional: Google Gemini API Key for LLM-powered natural language answers.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini Model selection.
# Defaults to 'gemini-1.5-flash-8b' (Google's smallest, fastest, most credit-efficient model)
# You can also use 'gemini-1.5-flash'
GEMINI_MODEL=gemini-1.5-flash-8b
